{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZeroLux",
  "mainBinaryName": "zerolux",
  "version": "0.0.1-dev",
  "identifier": "com.darkcompany.zerolux",
  "build": {
    "beforeDevCommand": "bun run assets",
    "beforeBuildCommand": "bun run assets",
    "frontendDist": "../dist/web"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "capabilities": [
        {
          "identifier": "desktop-startup",
          "description": "Choose a workspace from the packaged startup page only; no remote kernel UI permission",
          "local": true,
          "windows": ["manager"],
          "permissions": [
            "allow-workspace-action",
            "allow-workspace-adoption-preview",
            "allow-kernel-workspaces",
            "allow-choose-folder",
            "allow-autostart-status",
            "allow-autostart-set"
          ]
        },
        {
          "identifier": "tray-panel",
          "description": "The tray's packaged panel: the open workspaces' kernels and sign-ins, its own size and visibility, opening a workspace, system notifications and web links; no registry or process access",
          "local": true,
          "windows": ["tray"],
          "permissions": [
            "allow-tray-workspaces",
            "allow-tray-credential",
            "allow-tray-report",
            "allow-tray-resize",
            "allow-tray-hide",
            "allow-tray-open",
            "allow-tray-new-window",
            "allow-tray-notify",
            "allow-open-link",
            "core:event:allow-listen",
            "core:event:allow-unlisten",
            "notification:allow-is-permission-granted",
            "notification:allow-request-permission",
            "notification:allow-notify",
            "allow-update-status",
            "allow-update-check",
            "allow-update-channel",
            "allow-update-download",
            "allow-update-install"
          ]
        },
        {
          "identifier": "workspace-window",
          "description": "Packaged workspace controls, its own credentials, system notifications, web links opened in the system browser and folders chosen in the system panel; no registry or process access",
          "local": true,
          "windows": ["workspace-*"],
          "permissions": [
            "allow-window-control",
            "allow-open-link",
            "allow-choose-folder",
            "allow-read-workspace-credential",
            "allow-write-workspace-credential",
            "allow-autostart-status",
            "allow-autostart-set",
            "core:window:allow-start-dragging",
            "core:window:allow-internal-toggle-maximize",
            "core:window:allow-is-fullscreen",
            "core:event:allow-listen",
            "core:event:allow-unlisten",
            "notification:allow-is-permission-granted",
            "notification:allow-request-permission",
            "notification:allow-notify",
            "allow-update-status",
            "allow-update-check",
            "allow-update-channel",
            "allow-update-download",
            "allow-update-install",
            "allow-desktop-workspaces",
            "allow-desktop-switch",
            "allow-menu-commands",
            "allow-menu-sections",
            "allow-menu-run",
            "allow-menu-popup"
          ]
        }
      ],
      "csp": "default-src 'self'; script-src 'self' zerolux-ui://localhost http://zerolux-ui.localhost; style-src 'self' 'unsafe-inline'; img-src data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; media-src 'self' blob:; object-src 'none'; frame-src zerolux-ui://localhost http://zerolux-ui.localhost; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../dist/icons/32x32.png",
      "../dist/icons/128x128.png",
      "../dist/icons/128x128@2x.png",
      "../dist/icons/icon.icns",
      "../dist/icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "./Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true,
      "allowDowngrades": false
    }
  }
}
