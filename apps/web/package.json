{
  "name": "@zerolux/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run css && bun run renderer && bun run --parallel dev:css dev:server",
    "dev:css": "bun run css --watch=always",
    "dev:server": "bun --hot dev.ts",
    "css": "bun x --bun tailwindcss -i src/index.css -o generated/app.css",
    "renderer": "bun build renderer/code.ts renderer/mermaid.ts --outdir generated/renderer --target browser --production",
    "build": "bun run typecheck && bun run css --minify && bun run renderer && bun build ./index.html --outdir \"${ZEROLUX_WEB_OUTDIR:-dist}\" --target browser --production --public-path / && bun compress.ts \"${ZEROLUX_WEB_OUTDIR:-dist}\"",
    "typecheck": "bun x --bun tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/chivo": "^5.3.0",
    "@fontsource-variable/chivo-mono": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@streamdown/code": "^2.0.0",
    "@streamdown/mermaid": "^1.0.3",
    "@tauri-apps/api": "^2.10.1",
    "@zerolux/chat": "workspace:*",
    "@zerolux/theme": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.49.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.14.3",
    "react-router": "^8.4.0",
    "remark-breaks": "^4.0.0",
    "streamdown": "^2.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  }
}
